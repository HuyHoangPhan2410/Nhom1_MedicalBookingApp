"/></mxCell><mxCell id="n88" value="RefundQuote(340.000đ, 3 ghi chú)" style="html=1;rounded=0;fontSize=10;verticalAlign=bottom;align=center;strokeColor=#333333;strokeWidth=1.2;spacingBottom=1;fontFamily=Helvetica;fontColor=#222222;endArrow=open;endSize=8;dashed=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1475" y="542" as="sourcePoint"/><mxPoint x="1260" y="542" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n89" value="Mỗi decorator chỉ thêm đúng một khoản điều chỉnh và ghi một dòng diễn giải vào RefundQuote.notes; đổi thứ tự bọc hoặc thêm decorator mới (ví dụ giảm giá thành viên) không phải sửa các lớp còn lại." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1180" y="602" width="900" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>